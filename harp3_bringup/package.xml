<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harp3_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and parameters that start the HARP3 robot.</description>

  <maintainer email="95591405+robotcopper@users.noreply.github.com">robotcopper</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/robotcopper/harp3</url>
  <url type="bugtracker">https://github.com/robotcopper/harp3/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>harp3_behavior</exec_depend>
  <exec_depend>harp3_description</exec_depend>
  <exec_depend>harp3_manipulation</exec_depend>
  <exec_depend>harp3_navigation</exec_depend>
  <exec_depend>harp3_perception</exec_depend>
  <exec_depend>harp3_simulation</exec_depend>
  <exec_depend>harp3_ui</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>omni_wheel_drive_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
