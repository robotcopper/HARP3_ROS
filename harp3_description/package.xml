<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harp3_description</name>
  <version>0.0.0</version>
  <description>Kinematic and visual description of the HARP3 robot.</description>

  <maintainer email="95591405+robotcopper@users.noreply.github.com">robotcopper</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/robotcopper/harp3</url>
  <url type="bugtracker">https://github.com/robotcopper/harp3/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
